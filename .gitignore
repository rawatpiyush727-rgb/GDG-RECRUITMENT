# ==============================================================================
# GDG Recruitment Platform - Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
dist-ssr/
build/
*/dist/

# Environment files and secrets
.env
.env.*
*.env
!.env.example
!*/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS temporary files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# IDE agent scratch directories
.gemini/
.antigravity/
